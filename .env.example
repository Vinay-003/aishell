# Copy to .env and replace the placeholder locally; never commit credentials.
CLIFFY_PROVIDER=groq
GROQ_API_KEY=replace-with-your-own-key
# GROQ_MODEL=llama-3.1-8b-instant
# CLIFFY_NO_AI=1

# Use only one provider section; keep real values private.
# CLIFFY_PROVIDER=anthropic
# ANTHROPIC_API_KEY=replace-with-your-own-key
# CLIFFY_PROVIDER=openai
# OPENAI_API_KEY=replace-with-your-own-key
# CLIFFY_PROVIDER=gemini
# GEMINI_API_KEY=replace-with-your-own-key
# CLIFFY_PROVIDER=apinex
# APINEX_API_KEY=replace-with-your-own-key
# CLIFFY_MODEL=free/glm-5.3-flash
# CLIFFY_PROVIDER=custom
# CUSTOM_API_KEY=replace-with-your-own-key
# CLIFFY_BASE_URL=https://your-provider.example/v1
# CLIFFY_MODEL=your-model-id

# Timing (seconds). APInex default interval is 12.1 (5 RPM free tier).
# CLIFFY_MIN_INTERVAL=12.1
# CLIFFY_DEBOUNCE=0.20
# CLIFFY_CACHE_TTL=300
# CLIFFY_SUGGEST_TIMEOUT=30
# CLIFFY_TIMEOUT=30
# CLIFFY_SKIP_STARTUP_CHECK=1
